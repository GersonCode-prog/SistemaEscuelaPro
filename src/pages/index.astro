---
// Sitio público del colegio + presentación de los portales
import Publico from '../layouts/Publico.astro';
import { ROLES } from '../lib/escuela';
import { icono } from '../lib/iconos';
import { ruta } from '../lib/ruta';
import { ORDEN_ROLES, PUNTOS_ROL, USUARIO_DEMO } from '../lib/presentacion';

const ciclo = new Date().getFullYear();

const portales = ORDEN_ROLES.map((rol) => ({ rol, usuario: USUARIO_DEMO[rol], puntos: PUNTOS_ROL[rol] }));

const funciones = [
  { icono: 'notas', titulo: 'Calificaciones y boletas', texto: 'Notas por unidad, promedios automáticos y boleta lista para imprimir.', color: '#4f46e5' },
  { icono: 'asistencia', titulo: 'Asistencia diaria', texto: 'Presente, tarde o ausente en segundos, con historial y porcentajes.', color: '#059669' },
  { icono: 'tareas', titulo: 'Tareas en línea', texto: 'Se publican, se entregan y se califican con comentarios del maestro.', color: '#0891b2' },
  { icono: 'mensajes', titulo: 'Mensajería interna', texto: 'Familias, maestros y dirección conversan sin compartir números personales.', color: '#ea580c' },
  { icono: 'pagos', titulo: 'Pagos y recibos', texto: 'Colegiaturas, reporte de depósitos, validación y recibos al instante.', color: '#0284c7' },
  { icono: 'grafica', titulo: 'Reportes y estadísticas', texto: 'Rendimiento por grado y curso, alertas de riesgo y descargas en CSV.', color: '#7c3aed' },
];

const cifras = [
  { clave: 'estudiantes', valor: 48, texto: 'Estudiantes' },
  { clave: 'maestros', valor: 10, texto: 'Maestros' },
  { clave: 'secciones', valor: 6, texto: 'Secciones' },
  { clave: 'cursos', valor: 8, texto: 'Cursos' },
];
---
<Publico titulo="Colegio Valle Esmeralda · EscuelaPro">
  <div class="sitio">
    <!-- ===== Encabezado ===== -->
    <header class="s-cab" id="cabecera">
      <div class="s-contenedor s-cab-in">
        <a class="s-marca" href={ruta('/')}>
          <span class="s-logo"><Fragment set:html={icono('birrete', 22)} /></span>
          <span>Escuela<b>Pro</b><small data-cfg="colegio">Colegio Valle Esmeralda</small></span>
        </a>
        <nav class="s-nav" aria-label="Secciones">
          <a href="#portales">Portales</a><a href="#funciones">Funciones</a><a href="#eventos">Eventos</a><a href="#contacto">Contacto</a>
        </nav>
        <a class="s-btn s-btn-primario" id="btn-ingresar" href={ruta('/login')}><Fragment set:html={icono('entrar', 18)} /> <span>Ingresar</span></a>
      </div>
    </header>

    <!-- ===== Portada ===== -->
    <section class="s-hero">
      <div class="s-contenedor s-hero-in">
        <div class="s-hero-texto">
          <span class="s-pastilla">🎓 Ciclo escolar <span data-cfg="ciclo">{ciclo}</span> · Plataforma escolar</span>
          <h1>Toda la vida escolar, <span class="s-degradado">en un solo lugar</span></h1>
          <p>Notas, tareas, asistencia, horarios, pagos y avisos conectados para estudiantes, maestros, padres de familia, dirección y administración.</p>
          <div class="s-acciones">
            <a class="s-btn s-btn-primario s-btn-grande" href={ruta('/login')}>Ingresar al portal <Fragment set:html={icono('derecha', 18)} /></a>
            <a class="s-btn s-btn-claro s-btn-grande" href="#portales">Conocer los portales</a>
          </div>
          <div class="s-confianza">
            <div class="s-caritas">{portales.map((p) => <span style={`--c:${ROLES[p.rol].color}`}>{ROLES[p.rol].emoji}</span>)}</div>
            <p><strong>5 portales, un solo sistema.</strong><br />Cada persona ve solo lo que le corresponde.</p>
          </div>
        </div>

        <div class="s-mock" aria-hidden="true">
          <div class="s-ventana">
            <div class="s-ventana-barra"><i></i><i></i><i></i><em>escuelapro · portal del estudiante</em></div>
            <div class="s-ventana-cuerpo">
              <div class="s-mini-lateral">
                <span class="s-mini-logo"><Fragment set:html={icono('birrete', 16)} /></span>
                {['inicio', 'notas', 'tareas', 'reloj', 'asistencia', 'mensajes'].map((n, i) => <span class:list={['s-mini-item', { activo: i === 0 }]}><Fragment set:html={icono(n, 16)} /></span>)}
              </div>
              <div class="s-mini-contenido">
                <div class="s-mini-hola"><strong>¡Hola, Sofía! 👋</strong><small>Tienes 2 tareas para esta semana</small></div>
                <div class="s-mini-stats">
                  <div><small>Promedio</small><b>84.6</b><span class="s-sube">▲ 2.1</span></div>
                  <div><small>Asistencia</small><b>96%</b><span class="s-sube">Excelente</span></div>
                  <div><small>Tareas</small><b>2</b><span class="s-pend">Pendientes</span></div>
                </div>
                <div class="s-mini-grafica">
                  <small>Promedio por curso</small>
                  <div class="s-barras">{[72, 88, 91, 79, 95, 84].map((v, i) => <span style={`height:${v - 30}%;--d:${i * 0.08}s`}></span>)}</div>
                </div>
              </div>
            </div>
          </div>
          <div class="s-flota s-f1"><span>✅</span><div><strong>Tarea entregada</strong><small>Matemáticas · hace 2 min</small></div></div>
          <div class="s-flota s-f2"><span>🔔</span><div><strong>Nuevo aviso</strong><small>Feria de Ciencias</small></div></div>
          <div class="s-flota s-f3"><span>💬</span><div><strong>Prof. Carlos</strong><small>¡Excelente trabajo, Sofía!</small></div></div>
        </div>
      </div>

      <div class="s-contenedor">
        <div class="s-cifras">
          {cifras.map((c) => <div><b data-cuenta={c.clave}>{c.valor}</b><span>{c.texto}</span></div>)}
        </div>
      </div>
    </section>

    <!-- ===== Portales ===== -->
    <section class="s-seccion" id="portales">
      <div class="s-contenedor">
        <div class="s-titulo">
          <span class="s-etiqueta">Portales</span>
          <h2>Un portal para cada persona</h2>
          <p>Cada quien entra con su usuario y encuentra sus herramientas, con el color de su portal.</p>
        </div>
        <div class="s-portales">
          {portales.map((p) => (
            <article class="s-portal" style={`--c:${ROLES[p.rol].color}`}>
              <span class="s-portal-emoji">{ROLES[p.rol].emoji}</span>
              <h3>{ROLES[p.rol].portal}</h3>
              <p>{ROLES[p.rol].descripcion}</p>
              <ul>{p.puntos.map((x) => <li><Fragment set:html={icono('check', 16)} />{x}</li>)}</ul>
              <a class="s-portal-btn" href={ruta(`/login?rol=${p.rol}`)}>Entrar como {ROLES[p.rol].nombre.toLowerCase()} <Fragment set:html={icono('derecha', 16)} /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== Funciones ===== -->
    <section class="s-seccion s-seccion-blanca" id="funciones">
      <div class="s-contenedor">
        <div class="s-titulo">
          <span class="s-etiqueta">Funciones</span>
          <h2>Todo lo que el colegio necesita</h2>
          <p>Diseñado para que cualquier persona lo entienda desde el primer día.</p>
        </div>
        <div class="s-funciones">
          {funciones.map((f) => (
            <div class="s-funcion" style={`--c:${f.color}`}>
              <span class="s-funcion-icono"><Fragment set:html={icono(f.icono, 24)} /></span>
              <h3>{f.titulo}</h3>
              <p>{f.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== Demostración ===== -->
    <section class="s-seccion">
      <div class="s-contenedor">
        <div class="s-demo">
          <div>
            <span class="s-etiqueta s-etiqueta-clara">Demostración</span>
            <h2>Pruébalo ahora mismo 🧪</h2>
            <p>Entra con cualquiera de estas cuentas. La contraseña de todas es <b>12345</b>. Los datos son ficticios y se guardan solo en tu navegador.</p>
          </div>
          <div class="s-demo-cuentas">
            {portales.map((p) => (
              <a href={ruta(`/login?rol=${p.rol}`)} style={`--c:${ROLES[p.rol].color}`}>
                <span>{ROLES[p.rol].emoji}</span><div><strong>{p.usuario}</strong><small>{ROLES[p.rol].nombre}</small></div><Fragment set:html={icono('derecha', 16)} />
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Eventos y avisos ===== -->
    <section class="s-seccion s-seccion-blanca" id="eventos">
      <div class="s-contenedor">
        <div class="s-titulo">
          <span class="s-etiqueta">Agenda</span>
          <h2>Lo que viene en el colegio</h2>
          <p>Los eventos y avisos se actualizan desde el portal de dirección.</p>
        </div>
        <div class="s-agenda">
          <div class="s-caja"><h3><Fragment set:html={icono('calendario', 20)} /> Próximos eventos</h3><div id="lista-eventos" class="s-lista"></div></div>
          <div class="s-caja"><h3><Fragment set:html={icono('avisos', 20)} /> Avisos del colegio</h3><div id="lista-avisos" class="s-lista"></div></div>
        </div>
      </div>
    </section>

    <!-- ===== Pie ===== -->
    <footer class="s-pie" id="contacto">
      <div class="s-contenedor s-pie-in">
        <div>
          <a class="s-marca s-marca-clara" href={ruta('/')}>
            <span class="s-logo"><Fragment set:html={icono('birrete', 22)} /></span>
            <span>Escuela<b>Pro</b><small data-cfg="colegio">Colegio Valle Esmeralda</small></span>
          </a>
          <p class="s-lema">“<span data-cfg="lema">Aprender, crecer y servir</span>”</p>
        </div>
        <div>
          <h4>Contacto</h4>
          <p><Fragment set:html={icono('ubicacion', 16)} /> <span data-cfg="direccion">Ciudad de Guatemala</span></p>
          <p><Fragment set:html={icono('telefono', 16)} /> <span data-cfg="telefono">2200-1234</span></p>
          <p><Fragment set:html={icono('correo', 16)} /> <span data-cfg="correo">contacto@valleesmeralda.demo</span></p>
        </div>
        <div>
          <h4>Portales</h4>
          {portales.map((p) => <p><a href={ruta(`/login?rol=${p.rol}`)}>{ROLES[p.rol].portal}</a></p>)}
        </div>
      </div>
      <div class="s-contenedor s-pie-abajo">
        <span>© <span data-cfg="ciclo">{ciclo}</span> <span data-cfg="colegio">Colegio Valle Esmeralda</span></span>
        <span>Sistema de demostración con datos ficticios · Hecho con Astro</span>
      </div>
    </footer>
  </div>
</Publico>

<script>
  import { obtener, config } from '../lib/datos';
  import { leerSesion } from '../lib/sesion';
  import { ROLES, estudiantesActivos, textoAudiencia } from '../lib/escuela';
  import { escapar, hoy, MESES, relativa, aFecha } from '../lib/formato';
  import { ruta } from '../lib/ruta';

  // Datos del colegio (editables desde Configuración)
  const cfg = config() as unknown as Record<string, string | number>;
  document.querySelectorAll<HTMLElement>('[data-cfg]').forEach((el) => { const v = cfg[el.dataset.cfg!]; if (v !== undefined && v !== '') el.textContent = String(v); });

  // Cifras en vivo con animación
  const cuentas: Record<string, number> = {
    estudiantes: estudiantesActivos().length, maestros: obtener('maestros').length,
    secciones: obtener('grados').length, cursos: obtener('cursos').length,
  };
  document.querySelectorAll<HTMLElement>('[data-cuenta]').forEach((el) => {
    const fin = cuentas[el.dataset.cuenta!] ?? 0; const inicio = performance.now();
    const paso = (t: number) => { const p = Math.min(1, (t - inicio) / 900); el.textContent = String(Math.round(fin * (1 - Math.pow(1 - p, 3)))); if (p < 1) requestAnimationFrame(paso); };
    requestAnimationFrame(paso);
  });

  // Si ya hay sesión, el botón lleva directo al portal
  const s = leerSesion();
  if (s && ROLES[s.rol]) {
    const b = document.getElementById('btn-ingresar') as HTMLAnchorElement;
    b.href = ruta(`/${s.rol}/`);
    b.querySelector('span')!.textContent = 'Ir a mi portal';
  }

  // Próximos eventos
  const tonos: Record<string, string> = { Académico: '#4f46e5', Evento: '#059669', Reunión: '#ea580c', Feriado: '#dc2626' };
  const eventos = obtener('eventos').filter((e) => e.fecha >= hoy()).sort((a, b) => a.fecha.localeCompare(b.fecha)).slice(0, 4);
  document.getElementById('lista-eventos')!.innerHTML = eventos.length ? eventos.map((e) => {
    const d = aFecha(e.fecha);
    return `<div class="s-item" style="--c:${tonos[e.tipo] ?? '#4f46e5'}">
      <div class="s-fecha"><b>${d.getDate()}</b><small>${MESES[d.getMonth()].slice(0, 3)}</small></div>
      <div><strong>${escapar(e.titulo)}</strong><p>${escapar(e.descripcion)}</p><span class="s-chip">${escapar(e.tipo)} · ${relativa(e.fecha)}</span></div></div>`;
  }).join('') : '<p class="s-vacio">No hay eventos próximos.</p>';

  // Avisos para toda la comunidad
  const avisos = obtener('anuncios').filter((a) => a.audiencia !== 'maestros' && !a.gradoId)
    .sort((a, b) => Number(b.fijado) - Number(a.fijado) || b.fecha.localeCompare(a.fecha)).slice(0, 3);
  document.getElementById('lista-avisos')!.innerHTML = avisos.length ? avisos.map((a) => `
    <div class="s-item s-aviso"><span class="s-aviso-icono">${a.fijado ? '📌' : a.categoria === 'Urgente' ? '⚠️' : a.categoria === 'Evento' ? '🎉' : '📢'}</span>
      <div><strong>${escapar(a.titulo)}</strong><p>${escapar(a.contenido.length > 140 ? a.contenido.slice(0, 140) + '…' : a.contenido)}</p>
      <span class="s-chip">${escapar(a.categoria)} · ${escapar(textoAudiencia(a))}</span></div></div>`).join('') : '<p class="s-vacio">Sin avisos por ahora.</p>';

  // Sombra del encabezado al desplazarse
  const cab = document.getElementById('cabecera')!;
  const sombra = () => cab.classList.toggle('con-sombra', scrollY > 8);
  addEventListener('scroll', sombra, { passive: true }); sombra();
</script>

<style is:global>
  .sitio { --oscuro: #0f172a; --acento: #4f46e5; --acento-2: #059669; background: #f8fafc; overflow-x: clip; }
  .s-contenedor { width: min(1180px, 100% - 2.5rem); margin-inline: auto; }

  /* Encabezado */
  .s-cab { position: sticky; top: 0; z-index: 50; background: rgba(248, 250, 252, .78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid transparent; transition: border-color .2s, box-shadow .2s; }
  .s-cab.con-sombra { border-color: var(--borde); box-shadow: 0 6px 24px rgba(15, 23, 42, .06); }
  .s-cab-in { display: flex; align-items: center; gap: 1.5rem; height: 72px; }
  .s-marca { display: flex; align-items: center; gap: .7rem; font-weight: 800; font-size: 1.2rem; letter-spacing: -.02em; line-height: 1.1; }
  .s-marca b { color: var(--acento); }
  .s-marca small { display: block; font-size: .7rem; font-weight: 600; color: var(--texto-3); letter-spacing: 0; }
  .s-logo { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, #4f46e5, #059669); box-shadow: 0 8px 20px rgba(79, 70, 229, .3); }
  .s-nav { display: flex; gap: .3rem; margin-left: auto; }
  .s-nav a { padding: .5rem .85rem; border-radius: 10px; font-weight: 600; font-size: .92rem; color: var(--texto-2); transition: background .15s, color .15s; }
  .s-nav a:hover { background: #fff; color: var(--texto); }

  .s-btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .7rem 1.15rem; border-radius: 12px; font-weight: 700; font-size: .92rem; border: 1px solid transparent; cursor: pointer; transition: transform .15s, box-shadow .15s, background .15s; white-space: nowrap; }
  .s-btn:hover { transform: translateY(-1px); }
  .s-btn-primario { background: var(--oscuro); color: #fff; box-shadow: 0 8px 20px rgba(15, 23, 42, .18); }
  .s-btn-primario:hover { box-shadow: 0 12px 26px rgba(15, 23, 42, .25); }
  .s-btn-claro { background: #fff; border-color: var(--borde); color: var(--texto); }
  .s-btn-grande { padding: .95rem 1.4rem; font-size: 1rem; border-radius: 14px; }

  /* Portada */
  .s-hero { position: relative; padding: 4.5rem 0 3rem; }
  .s-hero::before { content: ''; position: absolute; inset: -72px 0 0; z-index: 0; pointer-events: none;
    background: radial-gradient(600px 380px at 85% 10%, rgba(79, 70, 229, .16), transparent 70%), radial-gradient(520px 360px at 60% 70%, rgba(5, 150, 105, .13), transparent 70%), radial-gradient(420px 300px at 5% 20%, rgba(234, 88, 12, .09), transparent 70%); }
  .s-hero > * { position: relative; z-index: 1; }
  .s-hero-in { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 3.5rem; align-items: center; }
  .s-hero-in > * { min-width: 0; }
  .s-pastilla { display: inline-flex; align-items: center; gap: .3rem; padding: .45rem .9rem; border-radius: 999px; background: #fff; border: 1px solid var(--borde); font-size: .82rem; font-weight: 700; color: var(--texto-2); box-shadow: var(--sombra); }
  .s-hero h1 { font-size: clamp(2.3rem, 5vw, 3.7rem); line-height: 1.06; letter-spacing: -.035em; font-weight: 800; margin: 1.2rem 0 1rem; }
  .s-degradado { background: linear-gradient(90deg, #4f46e5, #7c3aed 45%, #059669); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .s-hero-texto > p { font-size: 1.12rem; color: var(--texto-2); max-width: 34rem; }
  .s-acciones { display: flex; gap: .8rem; flex-wrap: wrap; margin: 2rem 0; }
  .s-confianza { display: flex; align-items: center; gap: 1rem; }
  .s-confianza p { font-size: .88rem; color: var(--texto-2); line-height: 1.4; }
  .s-confianza strong { color: var(--texto); }
  .s-caritas { display: flex; }
  .s-caritas span { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; font-size: 1.15rem; background: color-mix(in srgb, var(--c) 16%, white); border: 3px solid #f8fafc; margin-left: -10px; }
  .s-caritas span:first-child { margin-left: 0; }

  /* Maqueta del portal */
  .s-mock { position: relative; padding: 1.5rem 1.5rem 2.5rem; }
  .s-ventana { border-radius: 20px; background: #fff; box-shadow: 0 30px 80px rgba(15, 23, 42, .18), 0 0 0 1px rgba(15, 23, 42, .05); overflow: hidden; transform: perspective(1400px) rotateY(-6deg) rotateX(3deg); }
  .s-ventana-barra { display: flex; align-items: center; gap: .4rem; padding: .7rem 1rem; background: #f8fafc; border-bottom: 1px solid var(--borde); }
  .s-ventana-barra i { width: 11px; height: 11px; border-radius: 50%; background: #fca5a5; }
  .s-ventana-barra i:nth-child(2) { background: #fcd34d; }
  .s-ventana-barra i:nth-child(3) { background: #86efac; }
  .s-ventana-barra em { margin-left: .8rem; font-style: normal; font-size: .72rem; color: var(--texto-3); font-weight: 600; }
  .s-ventana-cuerpo { display: flex; min-height: 300px; }
  .s-mini-lateral { width: 58px; padding: .9rem 0; display: flex; flex-direction: column; align-items: center; gap: .45rem; border-right: 1px solid var(--borde); }
  .s-mini-logo { width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, #4f46e5, #818cf8); margin-bottom: .5rem; }
  .s-mini-item { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; color: var(--texto-3); }
  .s-mini-item.activo { background: #eef2ff; color: #4f46e5; }
  .s-mini-contenido { flex: 1; min-width: 0; padding: 1.1rem; display: grid; gap: .9rem; align-content: start; }
  .s-mini-hola { padding: 1rem; border-radius: 14px; color: #fff; background: linear-gradient(135deg, #4f46e5, #7c3aed); }
  .s-mini-hola strong { display: block; font-size: 1.02rem; }
  .s-mini-hola small { opacity: .85; font-size: .78rem; }
  .s-mini-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; }
  .s-mini-stats div { padding: .7rem; border-radius: 12px; border: 1px solid var(--borde); display: grid; }
  .s-mini-stats small { font-size: .68rem; color: var(--texto-3); font-weight: 700; }
  .s-mini-stats b { font-size: 1.25rem; letter-spacing: -.02em; }
  .s-sube { font-size: .66rem; font-weight: 700; color: #16a34a; }
  .s-pend { font-size: .66rem; font-weight: 700; color: #d97706; }
  .s-mini-grafica { padding: .8rem; border-radius: 12px; border: 1px solid var(--borde); }
  .s-mini-grafica small { font-size: .7rem; font-weight: 700; color: var(--texto-3); }
  .s-barras { height: 74px; display: flex; align-items: flex-end; gap: .55rem; margin-top: .5rem; }
  .s-barras span { flex: 1; border-radius: 6px 6px 3px 3px; background: linear-gradient(180deg, #818cf8, #4f46e5); transform-origin: bottom; animation: s-crecer .8s var(--d) both cubic-bezier(.2, .8, .2, 1); }
